# FlyGuard AI Configuration
APP_NAME="FlyGuard AI"
APP_ENV="development"
DEBUG=false

# Database (SQLite default; swap to postgresql+psycopg2://user:pass@localhost:5432/flyguard for PostgreSQL)
DATABASE_URL="sqlite:///./data/flyguard.db"

# API & CORS
API_HOST="0.0.0.0"
API_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Default Synthetic Generation Parameters
DEFAULT_SYNTHETIC_ACCOUNTS=20000
DEFAULT_SYNTHETIC_TRANSACTIONS=200000
DEFAULT_RANDOM_SEED=42

# Risk Thresholds (0-100 Normalized Risk Score)
RISK_THRESHOLD_MODERATE=35.0
RISK_THRESHOLD_HIGH=65.0
RISK_THRESHOLD_CRITICAL=85.0

# Safety Guard for Database Reset
ALLOW_DB_RESET=true

